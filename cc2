# وزن‌های از پیش محاسبه شده برای انتقال کاراکترهای پرتکرار (Character Bigrams)
COMMON_EN_BIGRAMS = {
    'th', 'he', 'in', 'er', 'an', 're', 'on', 'at', 'en', 'es', 'of', 'or', 'nt', 'ea', 'ti', 'to', 
