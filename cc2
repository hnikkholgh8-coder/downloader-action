keyboard = Controller()

def is_english_gibberish(word):
    """بررسی احتمال نامفهوم بودن کلمه انگلیسی بر اساس قواعد واژه‌سازی"""
    # حذف علائم نگارشی برای تحلیل دقیق خود کلمه
    clean_word = re.sub(r'[^\w]', '', word).lower()
    if len(clean_word) <= 1:
        return False
        
    vowels = set('aeiouy')
    v_count = sum(1 for c in clean_word if c in vowels)
    
    # ۱. کلماتی که هیچ حرف صداداری ندارند (مثلاً sghl یا shlh) احتمالاً اشتباه تایپی هستند
    if v_count == 0:
        return True
        
    # ۲. نسبت بسیار پایین حروف صدادار در کلمات بلند
    if len(clean_word) >= 4 and v_count / len(clean_word) < 0.15:
        return True

    # ۳. تتابع بیش از حد حروف بی‌صدا (۴ صامت یا بیشتر پشت سر هم)
    consonant_streak = 0
    for c in clean_word:
        if c not in vowels and c.isalpha():
            consonant_streak += 1
            if consonant_streak >= 4:
                return True
        else:
            consonant_streak = 0

    # ۴. تکرار پیاپی یک حرف بیش از دو بار
    for i in range(len(clean_word) - 2):
        if clean_word[i] == clean_word[i+1] == clean_word[i+2]:
            return True

    return False

def is_persian_gibberish(word):
    """بررسی احتمال نامفهوم بودن کلمه فارسی بر اساس حروف غیرهمخوان و مجاورت دکمه‌ها"""
    clean_word = re.sub(r'[^\w\u0600-\u06FF]', '', word)
    if len(clean_word) <= 1:
        return False

    # ۱. ترکیب حروف غیرممکن که به دلیل لغزش دست روی دکمه‌های مجاور کیبورد رخ می‌دهند
    invalid_combinations = {
        'سص', 'صث', 'ثق', 'فغ', 'غع', 'هخ', 'خح', 'جچ', 'شس', 'کگ', 'ظط', 'طز', 'رذ', 'ذد', 'دپ', 'پو',
        'اا', 'دد', 'وو', 'ذذ', 'رر', 'زز', 'ژژ'
    }
    for i in range(len(clean_word) - 1):
        if clean_word[i:i+2] in invalid_combinations:
            return True

    # ۲. عدم وجود حتی یکی از حروف بسیار پر تکرار زبان فارسی در کلمات بیش از دو حرف
    if len(clean_word) >= 3:
        common_chars = set('اویردنمهبتس')
        has_common = any(c in common_chars for c in clean_word)
        if not has_common:
            return True

    return False

def smart_correct_text(text):
    if not text:
        return text

    # تفکیک متن صرفاً بر اساس فضاهای خالی (اسپیس، تب، خط جدید) جهت تحلیل واژه‌ها بین دو اسپیس
    tokens = re.split(r'(\s+)', text)
    
    result = []
    for token in tokens:
        # اگر توکن فضای خالی بود، بدون تغییر به نتیجه اضافه شود
        if not token.strip():
            result.append(token)
            continue

        # تفکیک بخش الفبایی از علائم نگارشی احتمالی چسبیده به کلمه (مانند کاما یا نقطه در انتهای کلمه)
        match = re.match(r'^([^\w\u0600-\u06FF]*)([\w\u0600-\u06FF]+)([^\w\u0600-\u06FF]*)$', token)
        if not match:
            result.append(token)
            continue
            
        prefix, word, suffix = match.groups()

        has_fa = bool(re.search(r'[\u0600-\u06FF]', word))
        has_en = bool(re.search(r'[a-zA-Z]', word))

        if has_fa:
            # کلمه با حروف فارسی؛ در صورت نامفهوم بودن تبدیل به انگلیسی شود
            if is_persian_gibberish(word):
                converted = "".join(FA_TO_EN.get(c, c) for c in word)
                result.append(prefix + converted + suffix)
            else:
                result.append(token)
        elif has_en:
            # کلمه با حروف انگلیسی؛ در صورت نامفهوم بودن تبدیل به فارسی شود
            if is_english_gibberish(word):
                converted = "".join(EN_TO_FA.get(c, c) for c in word)
                result.append(prefix + converted + suffix)
            else:
                result.append(token)
        else:
            result.append(token)

    return "".join(result)

def safe_clip_get(retries=5, delay=0.05):
    for _ in range(retries):
        try:
            return pyperclip.paste()
        except Exception:
            time.sleep(delay)
    return ""

def safe_clip_set(text, retries=5, delay=0.05):
    for _ in range(retries):
        try:
            pyperclip.copy(text)
            return True
        except Exception:
            time.sleep(delay)
    return False

def on_activate():
    try:
        time.sleep(0.3)

        for key in [Key.ctrl, Key.shift, Key.alt, Key.cmd]:
            try:
                keyboard.release(key)
            except Exception:
                pass

        old_clipboard = safe_clip_get()
        safe_clip_set("")

        # شبیه‌سازی کپی متن
        keyboard.press(Key.ctrl)
        keyboard.press('c')
        time.sleep(0.08)
        keyboard.release('c')
        keyboard.release(Key.ctrl)

        time.sleep(0.12)
        selected_text = safe_clip_get()

        if not selected_text.strip():
            safe_clip_set(old_clipboard)
            return

        # تصحیح هوشمند متن بر مبنای تحلیل واژه‌ها
        corrected_text = smart_correct_text(selected_text)

        if safe_clip_set(corrected_text):
            # شبیه‌سازی پیست متن
            keyboard.press(Key.ctrl)
            keyboard.press('v')
            time.sleep(0.08)
            keyboard.release('v')
            keyboard.release(Key.ctrl)

        time.sleep(0.15)
        safe_clip_set(old_clipboard)

    except Exception:
        pass

def create_image():
    image = Image.new('RGB', (64, 64), color=(44, 62, 80))
    dc = ImageDraw.Draw(image)
    dc.rectangle([10, 22, 54, 42], outline=(236, 240, 241), width=3)
    dc.rectangle([15, 27, 21, 31], fill=(236, 240, 241))
    dc.rectangle([25, 27, 31, 31], fill=(236, 240, 241))
    dc.rectangle([35, 27, 41, 31], fill=(236, 240, 241))
    dc.rectangle([20, 35, 44, 38], fill=(236, 240, 241))
    return image

def setup_tray():
    def on_exit(icon, item):
        icon.stop()
        hotkey_listener.stop()

    icon_image = create_image()
    menu = pystray.Menu(pystray.MenuItem('Exit', on_exit))
    
    tooltip_text = "من زنده‌ام!\nمتن را انتخاب کنید و کلیدهای Ctrl+Shift+L را بزنید."
    
    icon = pystray.Icon("keyboard_converter", icon_image, title=tooltip_text, menu=menu)
    icon.run()

def add_to_startup():
    if os.name != 'nt':
        print("ثبت در استارتاپ فقط در سیستم‌عامل ویندوز پشتیبانی می‌شود.")
        return False
    
    import winreg
    
    if getattr(sys, 'frozen', False):
        app_path = os.path.abspath(sys.executable)
    else:
        app_path = f'"{os.path.abspath(sys.executable)}" "{os.path.abspath(sys.argv[0])}"'
        
    key_name = "WinKeyboardConverter"
    
    try:
        key = winreg.OpenKey(
            winreg.HKEY_CURRENT_USER,
            r"Software\Microsoft\Windows\CurrentVersion\Run",
            0,
            winreg.KEY_SET_VALUE
        )
        winreg.SetValueEx(key, key_name, 0, winreg.REG_SZ, app_path)
        winreg.CloseKey(key)
        print("برنامه با موفقیت به استارتاپ ویندوز اضافه شد.")
        return True
    except Exception as e:
        print(f"خطا در ثبت استارتاپ: {e}")
        return False

if __name__ == "__main__":
    if "--startup" in sys.argv:
        add_to_startup()

    # تعریف کلید میانبر جدید بر اساس درخواست شما (Ctrl + Shift + L)
    hotkey_listener = GlobalHotKeys({
        '<ctrl>+<shift>+l': on_activate
    })
    hotkey_listener.start()

    setup_tray()
